{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gh_write_guard.py",
            "timeout": 10,
            "statusMessage": "Checking gh/queue seat rules"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh api --method PUT repos/Jojos-Creations/phonux/pulls/*/merge*)",
      "Bash(gh api -X PUT repos/Jojos-Creations/phonux/pulls/*/merge*)"
    ]
  }
}
