{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git_guard.py",
            "timeout": 10,
            "statusMessage": "Checking shared-tree git rules"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gh_write_guard.py",
            "timeout": 10,
            "statusMessage": "Checking gh/queue seat rules"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 tools/queue/queue.py accept *)"
    ],
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add .)"
    ]
  }
}
