{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "./api-extractor.json",
  "mainEntryPointFilePath": "<projectFolder>/api-extractor-temp/dts/panelWindow.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFileName": "phonux-panelModel",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/api-extractor-temp/report/"
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-internal-missing-underscore": { "logLevel": "none", "addToApiReportFile": false }
    }
  }
}
