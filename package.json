{
  "name": "phonux",
  "version": "0.2.0-rc.6",
  "description": "A phone-shaped view host for React: write a view against a small set of host APIs, register it, and render it in one HostProvider.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./testing": "./fakeHost.ts",
    "./testing/row": "./testingRow.ts",
    "./sync": "./sync.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@mui/material": "^9.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "motion": "^13.3.0",
    "jsdom": "^26.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node tools/run-tests.mjs test/*.test.ts",
    "file-test": "node tools/run-tests-narrow.mjs",
    "build": "node tools/phonux-build.mjs",
    "phone": "playwright test -c playwright.phone.config.ts",
    "phone:webkit": "PHONE_PROJECTS=iphone-13-webkit playwright test -c playwright.phone.config.ts",
    "smoke": "node tools/phonux-pack-smoke.mjs",
    "check:api-report": "node tools/phonux-api-report.mjs",
    "check:frame-gap": "node tools/frame-gap-probe.mjs",
    "api-report:update": "node tools/phonux-api-report.mjs --local",
    "release:check": "node tools/phonux-release-check.mjs",
    "lint": "biome lint --error-on-warnings ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@microsoft/api-extractor": "^7.59.2",
    "@playwright/test": "1.56.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
