{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": ".",
  "newlineKind": "lf",
  "mainEntryPointFilePath": "<projectFolder>/../../../api-extractor-temp/dts/index.d.ts",
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.api-extractor.json"
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "phonux",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/../../../api-extractor-temp/report/"
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false }
}
