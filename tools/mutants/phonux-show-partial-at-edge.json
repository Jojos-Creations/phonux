{
  "tests": [
    "test/show-partial-at-edge.test.ts",
    "test/whole-panels.test.ts"
  ],
  "mutants": [
    {
      "name": "focus does not settle",
      "file": "Workspace.tsx",
      "find": "if (n.stops.length === 0) return;",
      "replace": "return;",
      "expectRed": [
        "focusing the cut-off neighbour"
      ]
    },
    {
      "name": "inert never set while the window cuts a stop",
      "file": "Workspace.tsx",
      "find": "rect.right <= view.left || rect.left >= view.right",
      "replace": "false",
      "expectRed": [
        "golden at the first stop"
      ]
    }
  ]
}
