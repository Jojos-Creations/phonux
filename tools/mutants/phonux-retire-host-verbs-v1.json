{
  "tests": [
    "test/host-panels-verbs.test.ts"
  ],
  "mutants": [
    {
      "name": "the row's own members leak through",
      "file": "hostPanels.ts",
      "find": "    panelList: provided.panelList,",
      "replace": "    ...provided,\n    panelList: provided.panelList,",
      "expectRed": [
        "none of the row's own"
      ]
    },
    {
      "name": "a verb never warns",
      "file": "hostPanels.ts",
      "find": "    warnDeprecatedVerb(verb, instead);\n    fn(...a);",
      "replace": "    fn(...a);",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "a verb warns every call",
      "file": "hostPanels.ts",
      "find": "|| warned.has(verb)) return;\n  warned.add(verb);",
      "replace": ") return;",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "close does nothing",
      "file": "hostPanels.ts",
      "find": "provided.close),",
      "replace": "() => undefined),",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "undoClose warns",
      "file": "hostPanels.ts",
      "find": "    undoClose: provided.undoClose,",
      "replace": "    undoClose: withWarning('undoClose', 'x', provided.undoClose),",
      "expectRed": [
        "do not warn"
      ]
    },
    {
      "name": "maxFitPanels dropped",
      "file": "hostPanels.ts",
      "find": "...(provided.maxFitPanels !== undefined ? { maxFitPanels: provided.maxFitPanels } : {}),",
      "replace": "",
      "expectRed": [
        "none of the row's own"
      ]
    },
    {
      "name": "move names the wrong replacement",
      "file": "hostPanels.ts",
      "find": "useWorkspace().panels.get(key)?.move(count)",
      "replace": "useWorkspace().panels.get(key)?.place(count)",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "activate names no replacement",
      "file": "hostPanels.ts",
      "find": "useWorkspace().panels.get(key)?.show()",
      "replace": "nothing",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "setSlots does nothing",
      "file": "hostPanels.ts",
      "find": "'useWorkspace().panels.get(key)?.setSlots(slots)', provided.setSlots)",
      "replace": "'useWorkspace().panels.get(key)?.setSlots(slots)', () => undefined)",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "reanchor does nothing",
      "file": "hostPanels.ts",
      "find": "'useWorkspace().panels.get(key)?.place(anchor)', provided.reanchor)",
      "replace": "'useWorkspace().panels.get(key)?.place(anchor)', () => undefined)",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "create does nothing",
      "file": "hostPanels.ts",
      "find": "    if (options === undefined) provided.create();\n    else provided.create(options);",
      "replace": "",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "create names no replacement",
      "file": "hostPanels.ts",
      "find": "useWorkspace().panels.addPanel(template)",
      "replace": "nothing",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    },
    {
      "name": "activate does nothing",
      "file": "hostPanels.ts",
      "find": "'useWorkspace().panels.get(key)?.show()', provided.activate)",
      "replace": "'useWorkspace().panels.get(key)?.show()', () => undefined)",
      "expectRed": [
        "each per-panel verb still does its work"
      ]
    }
  ]
}