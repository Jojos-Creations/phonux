{
  "tests": [
    "test/panel-resize-grips.test.ts",
    "test/default-frame.test.ts",
    "test/panel-chrome.test.ts"
  ],
  "mutants": [
    {
      "name": "the left grip pins the start edge",
      "file": "PanelResizeGrips.tsx",
      "find": "setDrawnWidth(d.width, side === 'left' ? 'end' : 'start')",
      "replace": "setDrawnWidth(d.width, 'start')",
      "expectRed": [
        "the left grip keeps the right edge"
      ]
    },
    {
      "name": "a move at clientX 0 is taken as a position",
      "file": "PanelResizeGrips.tsx",
      "find": "const x = clientX === 0 && d.lastX > FIREFOX_EDGE_X ? d.lastX : clientX;",
      "replace": "const x = clientX;",
      "expectRed": [
        "a move at clientX 0"
      ]
    },
    {
      "name": "the release rounds down to a slot",
      "file": "PanelResizeGrips.tsx",
      "find": "Math.round((width + gap) / (phone.width + gap))",
      "replace": "Math.floor((width + gap) / (phone.width + gap))",
      "expectRed": [
        "a move at clientX 0"
      ]
    },
    {
      "name": "ArrowRight grows the left grip too",
      "file": "PanelResizeGrips.tsx",
      "find": "step((e.key === 'ArrowRight') === (side === 'right'))",
      "replace": "step(e.key === 'ArrowRight')",
      "expectRed": [
        "Arrow keys step one slot"
      ]
    },
    {
      "name": "an Arrow key lets the event through",
      "file": "PanelResizeGrips.tsx",
      "find": "        e.preventDefault();\n        step(",
      "replace": "        step(",
      "expectRed": [
        "Arrow keys step one slot"
      ]
    },
    {
      "name": "a cancelled drag settles",
      "file": "PanelResizeGrips.tsx",
      "find": "if (d !== null && d.pointerId === e.pointerId) finish(d, false);\n      }}\n      onLostPointerCapture",
      "replace": "if (d !== null && d.pointerId === e.pointerId) finish(d, true);\n      }}\n      onLostPointerCapture",
      "expectRed": [
        "a cancelled drag"
      ]
    },
    {
      "name": "a panel that is not resizable gets grips",
      "file": "PanelResizeGrips.tsx",
      "find": "!slot.resizable || ",
      "replace": "",
      "expectRed": [
        "resizable false"
      ]
    },
    {
      "name": "one slot of room still draws grips",
      "file": "PanelResizeGrips.tsx",
      "find": "(slot.slotRange?.most ?? 1) < 2",
      "replace": "(slot.slotRange?.most ?? 1) < 1",
      "expectRed": [
        "one slot of room"
      ]
    },
    {
      "name": "the grips are not named",
      "file": "labels.ts",
      "find": "resizeGrip: (side) => `Resize",
      "replace": "resizeGrip: (side) => `Resized",
      "expectRed": [
        "named and valued"
      ]
    },
    {
      "name": "the default frame draws no grips",
      "file": "defaultFrame.tsx",
      "find": "overlay={<PanelResizeGrips />}",
      "replace": "",
      "expectRed": [
        "shows a grip on each side"
      ]
    },
    {
      "name": "a press needs no travel to become a resize",
      "file": "PanelResizeGrips.tsx",
      "find": "if (Math.abs(dx) < DRAG_START_PX) return;",
      "replace": "if (Math.abs(dx) < 0) return;",
      "expectRed": [
        "a press that travels under 4 px"
      ]
    },
    {
      "name": "the threshold is 5 px",
      "file": "PanelResizeGrips.tsx",
      "find": "const DRAG_START_PX = 4;",
      "replace": "const DRAG_START_PX = 5;",
      "expectRed": [
        "a press that travels under 4 px"
      ]
    },
    {
      "name": "the click after a drag reaches the panel",
      "file": "PanelResizeGrips.tsx",
      "find": "if (!swallowClick.current) return;",
      "replace": "return;",
      "expectRed": [
        "the click a browser fires after a drag"
      ]
    },
    {
      "name": "the swallow is never cleared by a timer",
      "file": "PanelResizeGrips.tsx",
      "find": "      setTimeout(() => {\n        swallowClick.current = false;\n      }, 0);\n",
      "replace": "",
      "expectRed": [
        "the click a browser fires after a drag"
      ]
    },
    {
      "name": "a press that never moved still swallows its click",
      "file": "PanelResizeGrips.tsx",
      "find": "    if (d.moved) {\n      if (settle)",
      "replace": "    swallowClick.current = true;\n    if (d.moved) {\n      if (settle)",
      "expectRed": [
        "the click a browser fires after a drag"
      ]
    }
  ]
}
