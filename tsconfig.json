{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "panels/**/*.ts",
    "panels/**/*.tsx",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "api-extractor-temp"
  ]
}
